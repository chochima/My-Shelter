<!--非首頁隱藏-->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const path = location.pathname;
    const isIndex = (path === "/" || path.endsWith("index.html"));

    // 只在首頁顯示
    document.querySelectorAll(".index-visible").forEach(el => {
      el.style.display = isIndex ? "block" : "none";
    });

    // 只在首頁隱藏
    document.querySelectorAll(".index-hidden").forEach(el => {
      el.style.display = isIndex ? "none" : "block";
    });
  });
</script>

















