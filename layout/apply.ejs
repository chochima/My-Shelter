<body class="">

  <!--1.認養書須知 > lable-->
  <nav class="container d-flex pt-7 px-0">
    <section class="w-100">

      <button class="btn row detail-lable" type="button" data-bs-toggle="collapse" data-bs-target="#collapseExample1" aria-expanded="false" aria-controls="collapseExample1">

        <div class="col-auto px-0 py-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="mb-1" width="32" height="32" viewBox="0 0 24 24"><path fill="currentColor" fill-rule="evenodd" d="M2 12C2 6.477 6.477 2 12 2s10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12Zm11.5-5a1 1 0 0 0-1.707-.707l-2 2a1 1 0 0 0 1.414 1.414l.293-.293V17a1 1 0 1 0 2 0V7Z" clip-rule="evenodd"/></svg>
        </div>

        <h4 class="col-auto mb-0 ps-2 ps-lg-4">填寫認養申請書之前，請先確認以下資訊</h4>

        <div class="col-auto px-0 py-0 mb-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-chevron-down" viewBox="0 0 16 16">
          <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708"/></svg>
        </div>

        
        </svg>
      </button>
    </section>
  </nav>

  <!--1.認養書須知 > 內文-->
  <section class="container px-0">
      <div class="collapse" id="collapseExample1">
        <div class="px-9">

          <!--須知事項-->
          <ol class="px-4">
            <li>申請人需年滿25歲且有獨立自主的經濟能力</li>
            <li>申請人必須是主要與寶貝所屬機構溝通的聯繫對象</li>
            <li>每次僅能領養一隻，下次領養申請需間隔半年</li>
            <li>領養前，寶貝所屬機構會為寶貝進行結紮並施打晶片，若因特殊情況尚未結紮，新飼主同意寶貝所屬機構於規定時間內完成結紮</li>
            <li>申請單通過審核後，申請人願意全程配合寶貝所屬機構進行後續面談流程，且同意簽署正式領養協議書</li>
            <li>同意寶貝所屬機構進行家訪</li>
            <li>領養用途僅為寵物陪伴，不涉及任何商業展售或動物利用</li>
            <li>填寫領養申請書不等於領養，還需經過寶貝所屬機構面談評估等流程</li>
            <li>寶貝所屬機構有權拒絕有疑慮的領養人</li>
            <li>領養後，本平台及寶貝所屬機構會追蹤後續狀態，若評估不適合，寶貝所屬機構有權將寶貝帶回</li>

          </ol>


          <!--確認框-->
          <div class="form-check">
            <input class="form-check-input mb-1" style="width: 24px; height: 24px;" type="checkbox" value="" id="flexCheckIndeterminate">
              <label class="form-check-label fs-5 ps-4" for="flexCheckIndeterminate">
              我已詳閱且同意以上認養資訊
              </label>
          </div>




        </div>
      </div>

  </section>


  <!--2.填寫領養人資料 > lable-->
  <nav class="container d-flex pt-7 px-0">
    <section class="w-100">

      <button class="btn row detail-lable" type="button" data-bs-toggle="collapse" data-bs-target="#collapseExample2" aria-expanded="false" aria-controls="collapseExample2">

        <div class="col-auto px-0 py-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="mb-1" width="32" height="32" viewBox="0 0 24 24">
          <path fill="currentColor" fill-rule="evenodd" d="M2 12C2 6.477 6.477 2 12 2s10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12Zm8.5-2.5a1.5 1.5 0 1 1 2.56 1.06l-3.828 3.83a2.5 2.5 0 0 0-.732 1.767V17a1 1 0 0 0 1 1h5a1 1 0 1 0 0-2h-3.975a.5.5 0 0 1 .121-.197l3.829-3.828A3.5 3.5 0 1 0 8.5 9.5a1 1 0 1 0 2 0Z" clip-rule="evenodd"/>
          </svg>
        </div>

        <h4 class="col-auto mb-0 ps-2 ps-lg-4">填寫領養人資料</h4>

        <div class="col-auto px-0 py-0 mb-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-chevron-down" viewBox="0 0 16 16">
          <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708"/></svg>
        </div>

      </button>
    </section>
  </nav>

  <!--2.填寫領養人資料 > 內文-->
  <section class="container px-0">
      <div class="collapse" id="collapseExample2">
        <div class="px-9">

          <!--須知事項-->
          <form>

            <!--真實性名-->
            <div class="row apply-form">
              <div>
                <label for="exampleInputText" class="form-label mb-0 fs-5">真實性名</label>
              </div>

              <span id="passwordHelpBlock" class="form-text">
                請輸入您有效身份證上所登記的正式名稱。
              </span>

              <div class="col-12 col-md-4">
                <input type="text" class="form-control " id="exampleInputText" placeholder="">
              </div>
            </div>

            <!--性別-->
            <div class="row apply-form">

              <div>
                <label for="exampleInputText" class="form-label mb-0 fs-5">性別</label>
              </div>

              <div class="d-flex"> <!--表單內容-->
                <div class="form-check form-check-inline d-flex align-items-center">
                  <input class="form-check-input me-2" type="radio" name="inlineRadioOptions" id="gender-1" value="option1">
                  <label class="form-check-label" for="gender-1">男性</label>
                </div>

                <div class="form-check form-check-inline d-flex align-items-center">
                  <input class="form-check-input me-2" type="radio" name="inlineRadioOptions" id="gender-2" value="option1">
                  <label class="form-check-label" for="gender-2">女性</label>
                </div>

                <div class="form-check form-check-inline d-flex align-items-center">
                  <input class="form-check-input me-2" type="radio" name="inlineRadioOptions" id="gender-3" value="option1">
                  <label class="form-check-label" for="gender-3">不便透露</label>
                </div>
              </div>
              
            </div>

            <!--出生年月日-->
            <div class="apply-form">
              <div>
                <label for="adoptDate" class="form-label mb-0 fs-5">出生 年/月/日</label>
              </div>

              <span id="passwordHelpBlock" class="form-text">
                請輸入您實際登記的出生年月日，領養面談時需要與您的證件做核對。
              </span>


              <div class="d-flex"> <!--表單內容-->
                <div class="form-check form-check-inline d-flex align-items-center ps-0">
                  <input type="date" class="form-control" id="adoptDate" name="adoptDate">
                </div>

                <div class="form-check form-check-inline d-flex align-items-center">
                  <input class="form-check-input me-2" type="radio" name="inlineRadioOptions" id="inlineRadio1" value="option1">
                  <label class="form-check-label" for="inlineRadio1">同會員資料</label>
                </div>
              </div>

            </div>

            <!--手機號碼-->
            <div class="apply-form">
              <div>
                <label for="adoptDate" class="form-label mb-0 fs-5">手機號碼</label>
              </div>

              <span id="passwordHelpBlock" class="form-text">
                請輸入您目前正在使用的有效號碼。
              </span>


              <div class="d-flex"> <!--表單內容-->
                <div class="form-check form-check-inline d-flex align-items-center ps-0">
                  <input 
                    type="tel" 
                    class="form-control" 
                    id="phoneNumber" 
                    name="phoneNumber" 
                    pattern="[0-9]{4}-[0-9]{3}-[0-9]{3}" 
                    required>
                </div>

                <div class="form-check form-check-inline d-flex align-items-center">
                  <input class="form-check-input me-2" type="radio" name="inlineRadioOptions" id="inlineRadio1" value="option1">
                  <label class="form-check-label" for="inlineRadio1">同會員資料</label>
                </div>
              </div>

            </div>

            <!--電子信箱-->
            <div class="apply-form">
              <div>
                <label for="adoptDate" class="form-label mb-0 fs-5">電子信箱</label>
              </div>

              <span id="passwordHelpBlock" class="form-text">
                請留下您實際在使用的電子郵件信箱，作為主要通知與溝通管道。
              </span>


              <div class="d-flex"> <!--表單內容-->
                <div class="form-check form-check-inline d-flex align-items-center ps-0">
                  <input type="email" class="form-control" id="exampleFormControlInput1" placeholder="">
                </div>

                <div class="form-check form-check-inline d-flex align-items-center">
                  <input class="form-check-input me-2" type="radio" name="inlineRadioOptions" id="inlineRadio1" value="option1">
                  <label class="form-check-label" for="inlineRadio1">同會員資料</label>
                </div>
              </div>

            </div>



          </form>
          <!--須知事項-->

        </div>
      </div>
  </section>


  <!--3.領養​條件​評估 > lable-->
  <nav class="container d-flex pt-7 px-0">
    <section class="w-100">

      <button class="btn row detail-lable" type="button" data-bs-toggle="collapse" data-bs-target="#collapseExample3" aria-expanded="false" aria-controls="collapseExample3">

        <div class="col-auto px-0 py-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="mb-1" width="32" height="32" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12S6.477 2 12 2m1 5h-2l-.15.005A2 2 0 0 0 9 9a1 1 0 0 0 1.974.23l.02-.113L11 9h2v2h-2l-.133.007c-1.111.12-1.154 1.73-.128 1.965l.128.021L11 13h2v2h-2l-.007-.117A1 1 0 0 0 9 15a2 2 0 0 0 1.85 1.995L11 17h2l.15-.005a2 2 0 0 0 1.844-1.838L15 15v-2l-.005-.15a2 2 0 0 0-.17-.667l-.075-.152l-.019-.032l.02-.03a2 2 0 0 0 .242-.795L15 11V9l-.005-.15a2 2 0 0 0-1.838-1.844z"/></svg>
        </div>

        <h4 class="col-auto mb-0 ps-2 ps-lg-4">領養​條件​評估</h4>

        <div class="col-auto px-0 py-0 mb-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-chevron-down" viewBox="0 0 16 16">
          <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708"/></svg>
        </div>

      </button>
    </section>
  </nav>

  <!--3.領養​條件​評估 > 內文-->
  <section class="container px-0">
      <div class="collapse" id="collapseExample3">
        <div class="px-9">
          <h8>為評估​您​是否​準​備​好​領養​寶貝，​請​依真實情​況​填寫</h8>

          <!--須知事項-->
          <form>



            <!--月收入概況-->
            <div class="row apply-form">

              <div>
                <label for="exampleInputText" class="form-label mb-0 fs-5">月收入概況</label>
              </div>

              <div class="d-flex"> <!--表單內容-->
                <div class="form-check form-check-inline d-flex align-items-center">
                  <input class="form-check-input me-2" type="radio" name="inlineRadioOptions" id="monthly-income-01" value="option1">
                  <label class="form-check-label" for="monthly-income-01">3萬以下</label>
                </div>

                <div class="form-check form-check-inline d-flex align-items-center">
                  <input class="form-check-input me-2" type="radio" name="inlineRadioOptions" id="monthly-income-02" value="option1">
                  <label class="form-check-label" for="monthly-income-02">3-5萬</label>
                </div>

                <div class="form-check form-check-inline d-flex align-items-center">
                  <input class="form-check-input me-2" type="radio" name="inlineRadioOptions" id="monthly-income-03" value="option1">
                  <label class="form-check-label" for="monthly-income-03">5-10萬</label>
                </div>

                <div class="form-check form-check-inline d-flex align-items-center">
                  <input class="form-check-input me-2" type="radio" name="inlineRadioOptions" id="monthly-income-04" value="option1">
                  <label class="form-check-label" for="monthly-income-04">10萬以上</label>
                </div>
              </div>
              
            </div>

            <!--同​住家​人​願意​協助​一起​照顧寶​貝嗎-->
            <div class="row apply-form">

              <div>
                <label for="exampleInputText" class="form-label mb-0 fs-5">同​住家​人​願意​協助​一起​照顧寶​貝嗎</label>
              </div>

              <div class="d-flex"> <!--表單內容-->
                <div class="form-check form-check-inline d-flex align-items-center">
                  <input class="form-check-input me-2" type="radio" name="inlineRadioOptions" id="family-help-01" value="option1">
                  <label class="form-check-label" for="family-help-01">同意</label>
                </div>

                <div class="form-check form-check-inline d-flex align-items-center">
                  <input class="form-check-input me-2" type="radio" name="inlineRadioOptions" id="family-help-02" value="option1">
                  <label class="form-check-label" for="family-help-02">不確定</label>
                </div>

                <div class="form-check form-check-inline d-flex align-items-center">
                  <input class="form-check-input me-2" type="radio" name="inlineRadioOptions" id="family-help-03" value="option1">
                  <label class="form-check-label" for="family-help-03">不允許</label>
                </div>

                <div class="form-check form-check-inline d-flex align-items-center">
                  <input class="form-check-input me-2" type="radio" name="inlineRadioOptions" id="family-help-04" value="option1">
                  <label class="form-check-label" for="family-help-04">我​獨自​生活​</label>
                </div>
              </div>
              
            </div>



            <!--未來如遇到結婚、生小孩、搬家、出國工作等人生其他計畫時，您將計畫如何安置寶貝？-->
            <div class="apply-form">
              <label for="adoptDate" class="form-label mb-0 fs-5">未來如遇到結婚、生小孩、搬家、出國工作等人生其他計畫時，您將計畫如何安置寶貝？</label>
              <textarea class="form-control p-2 my-2" style="border-radius: 8px;"  id="emergencies-Textarea" rows="3"></textarea>
            </div>

            <!--近​期​方​便​電話​訪問​的​時段？​-->
            <div class="apply-form">
              <label for="adoptDate" class="form-label mb-0 fs-5">近​期​方​便​電話​訪問​的​時段？</label>

              <div class="col-12 col-md-4">
                <input type="text" class="form-control " id="phone-time-Textarea" placeholder="">
              </div>
            </div>

            <!--是否​接受​家​訪？-->
            <div class="apply-form">
              <div>
                <label for="adoptDate" class="form-label mb-0 fs-5">是否​接受​家​訪？</label>
              </div>

              <span id="passwordHelpBlock" class="form-text">
                家訪​的​目的​是​希望​可以​與​您​一同​打造​寶貝​的​生活​環境，​加速​寶貝​適應；​若無法​家訪，​請於​電訪​時告知​所​屬機構​原因。​
              </span>


              <div class="d-flex"> <!--表單內容-->
                <div class="form-check form-check-inline d-flex align-items-center">
                  <input class="form-check-input me-2" type="radio" name="inlineRadioOptions" id="home-visits-01" value="option1">
                  <label class="form-check-label" for="inlineRadio1">是</label>
                </div>

                <div class="form-check form-check-inline d-flex align-items-center">
                  <input class="form-check-input me-2" type="radio" name="inlineRadioOptions" id="home-visits-02" value="option1">
                  <label class="form-check-label" for="inlineRadio1">否</label>
                </div>
              </div>

            </div>

            <!--有​什麼​想​跟​寶貝​所​屬機​構說​的​嗎?​​-->
            <div class="apply-form">
              <label for="adoptDate" class="form-label mb-0 fs-5">有​什麼​想​跟​寶貝​所​屬機​構說​的​嗎?</label>
              <textarea class="form-control p-2 my-2" style="border-radius: 8px;"  id="else-Textarea" rows="3"></textarea>
            </div>



          </form>
          <!--須知事項-->

        </div>
      </div>
  </section>






















  












</body>



